%% Диаграмма вариантов использования (UC-1…UC-8).
%% Актор — пользователь ПК; внешние системы (Ollama, Open-Meteo, Windows) показаны справа.
%% Основные сценарии: команда ПК, чат с LLM, таймер, опасное действие с подтверждением.
%% «Обновить список программ» и «Настроить ассистента» — вспомогательные, доступны из трея.
%% Диаграмма отражает требования FR-1…FR-16 из docs/requirements.md.
flowchart LR
    U[Пользователь]

    subgraph Jarvis["Джарвис"]
        UC1([Активировать ассистента])
        UC2([Выполнить команду ПК])
        UC3([Вести диалог с LLM])
        UC4([Поставить таймер])
        UC5([Подтвердить опасное действие])
        UC6([Настроить ассистента])
        UC7([Обновить список программ])
        UC8([Задать вопрос кнопкой «Говорить»])
    end

    OLLAMA[(Ollama)]
    METEO[(Open-Meteo)]
    WIN[Windows / приложения]

    U --> UC1
    U --> UC2
    U --> UC3
    U --> UC4
    U --> UC6
    U --> UC8
    UC2 --> UC5
    UC5 --> WIN
    UC2 --> WIN
    UC3 --> OLLAMA
    UC8 --> OLLAMA
    UC2 --> METEO
    UC6 --> UC7
    U --> UC7
